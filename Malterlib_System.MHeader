Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_System}"
{
	%Group "System"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/System/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_System: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "System"
	{
		!!MalterlibLibrary_System true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_System: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_System true
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_System"
	//MalterlibTestFiles_Malterlib_System: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

